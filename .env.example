# ============================================================
# gpt_backend 环境变量模板
# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，不会提交。
#   cp .env.example .env
# ============================================================

# ---------- 运行环境 ----------
# 路由前缀，接口形如 /apiAI/user/xxx
NGINX_ROUTER=apiAI
# 服务监听端口（main_app.py 默认 8888）
APP_PORT=8888

# ---------- 数据库 ----------
# 例：mysql+pymysql://user:password@127.0.0.1:3306/gpt_db
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/gpt_db

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
# 各业务用途使用的 db 编号
REDIS_DB_TOKEN=0
REDIS_DB_BILL=1
REDIS_DB_SIGN=2
REDIS_DB_TOOL=3
REDIS_DB_SMI_CODE=3
REDIS_DB_USER_MESSAGE=4
REDIS_DB_USER_ASK=5
REDIS_DB_USER_ASK_TOKEN=6

# ---------- 上游模型 ----------
# 对话兼容接口
GPT_URL=https://api.binjie.fun/api/generateStream
GPT_URL_OPENAI_OLD=https://api.openai.com/v1/chat/completions
GPT_URL_OPENAI_NEW=https://api.openai.com/v1/completions
# OpenAI 官方密钥与组织
OPENAI_API_KEY=
OPENAI_ORG_ID=
# 可选 HTTP 代理，例如 http://127.0.0.1:7890，留空表示直连
OPENAI_PROXY=
# 站内图像中转地址（TeamRouter / claude_proxy，默认监听 127.0.0.1:4000）
# 注意不要填成本服务的 8888，否则绘图会打到自己
LLM_PROXY_BASE=https://www.rabbitj.top/v1

# ---------- 邮件（SMTP 验证码） ----------
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ---------- 短信（网易云信） ----------
SMS_API_URL=https://api.netease.im/sms/sendcode.action
SMS_APP_KEY=
SMS_APP_SECRET=

# ---------- 支付宝 ----------
ALI_APP_ID=
# 私钥/公钥文件路径（不要提交到仓库）
ALI_APP_PRIVATE_KEY_FILE=./secrets/alipay_app_private_key.txt
ALI_APP_PUBLIC_KEY_FILE=./secrets/alipay_public_key.txt
ALI_PAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do?{}
ALI_RETURN_URL_FRONT=http://127.0.0.1:8888/apiAI/user/verify_pay
ALI_RETURN_URL_BACK=http://127.0.0.1:8888/apiAI/user/verify_rabbit

# ---------- 微信支付 v3 ----------
# 商户号（证书文件名前缀即是商户号）
WXPAY_MCHID=
# 商户 API 证书序列号，可从 apiclient_cert.pem 读取：
#   openssl x509 -in apiclient_cert.pem -noout -serial
WXPAY_CERT_SERIAL_NO=
# APIv3 密钥：商户平台「账户中心-API安全」自行设置的 32 位密钥。
# 注意不是 apiv2 密钥，也不是商户私钥。
WXPAY_APIV3_KEY=
# 公众号/网站应用 appid
WXPAY_APPID=
# 回调地址，必须是 https 且公网可达，路径指向 /apiAI/user/wxpay/notify
WXPAY_NOTIFY_URL=https://your.domain/apiAI/user/wxpay/notify
# 商户 API 证书私钥文件（apiclient_key.pem），只填路径
WXPAY_PRIVATE_KEY_FILE=/etc/security/apiclient_key.pem
# 平台证书缓存目录；仅老商户（平台证书模式）需要
WXPAY_CERT_DIR=
# 验签模式二选一：
#   新商户：同时填 WXPAY_PUBLIC_KEY_FILE 与 WXPAY_PUBLIC_KEY_ID
#   老商户：两项留空，由 SDK 自动下载平台证书
WXPAY_PUBLIC_KEY_FILE=
WXPAY_PUBLIC_KEY_ID=
# 服务商模式，直连商户保持 false
WXPAY_PARTNER_MODE=false
# 可选 HTTP 超时，格式为 连接,读取（秒）
WXPAY_TIMEOUT=5,15
# 可选代理
WXPAY_PROXY=

# ---------- 蓝兔支付（ltzf） ----------
LTZF_MCH_ID=
LTZF_PARTNER_KEY=
LTZF_API_HOST=api.ltzf.cn
LTZF_QUIT_URL=
LTZF_RETURN_URL=

# ---------- 文件存储 ----------
# 对外下载地址前缀
FILE_STORE_ADDR=http://127.0.0.1:8888/apiAI/user/file
# 服务器本地文档/图片存储目录
FILE_STORE_LINUX_PWD=./data/docs
# pandoc 可执行文件路径，留空则依次尝试 /usr/bin/pandoc 等常见位置
PYPANDOC_PANDOC=

# ---------- 权限与展示 ----------
# 超级用户 id / 手机号，逗号分隔
SUPER_USER_ID_LIST=
SUPER_ADMIN_PHONES=
# 客服手机号，留空则前端不展示
SUPPORT_PHONE=
# 允许免登录访问 /docs 的来源，逗号分隔
DOCS_REFERERS=http://127.0.0.1:8888/docs

# ---------- 可选脚本配置 ----------
# 侧链路签到脚本
SOCKBOOM_CHECKIN_URL=
SOCKBOOM_TOKEN=
TOKEN_URL=http://127.0.0.1:8889/openaiKey
